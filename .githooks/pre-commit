#!/bin/sh
# Local quality gate. CI is intentionally disabled until the app-finishing
# work lands, so this hook is the check: lint, format, fast test suite.
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

RUFF=".venv/bin/ruff"
if [ ! -x "$RUFF" ]; then
    echo "pre-commit: $RUFF not found — run .venv/bin/pip install -r requirements-dev.txt" >&2
    exit 1
fi

"$RUFF" check .
"$RUFF" format --check .
.venv/bin/python3 -m pytest -q -m "not model"
